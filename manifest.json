{
	"manifest_version": 3,
	"name": "Explaina - Explain with AI",
	"version": "1.0.0",
	"description": "Explain selected text using AI with page context.",
	"permissions": ["contextMenus", "activeTab", "storage"],
	"host_permissions": ["https://explaina-799886936820.us-central1.run.app/*"],
	"icons": {
		"16": "./assets/16.png",
		"32": "./assets/32.png",
		"48": "./assets/48.png",
		"128": "./assets/128.png"
	},
	"options_ui": {
		"page": "options.html",
		"open_in_tab": true
	},
	"action": {
		"default_popup": "popup.html"
	},
	"background": {
		"service_worker": "dist/background.js"
	},
	"content_scripts": [
		{
			"matches": ["<all_urls>"],
			"js": ["dist/content.js"]
		}
	],
	"commands": {
		"_execute_action": {
			"suggested_key": {
				"default": "Ctrl+Shift+E",
				"mac": "Command+Shift+E"
			},
			"description": "Open Explaina popup"
		}
	}
}
